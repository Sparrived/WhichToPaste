<Window x:Class="WhichToPaste.UI.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WhichToPaste.Models"
        Title="WhichToPaste" Width="460" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Border x:Name="Root" Margin="14" CornerRadius="18" BorderThickness="1"
            Background="{DynamicResource SurfaceContainerBrush}"
            BorderBrush="{DynamicResource OutlineVariantBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.22" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Margin="20,15,20,9">
                <TextBlock Text="剪贴板历史" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                <TextBlock x:Name="CountText" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 历史列表（新 → 旧） -->
            <ListBox x:Name="ItemList" Grid.Row="1" Style="{StaticResource PickerList}"
                     Margin="10,0,10,6" MaxHeight="352">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ClipItem}">
                        <Grid Height="46" Margin="4,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 左侧竖条：越靠上（越新）越实，把"新到旧"变成看得见的结构 -->
                            <Border Width="3" CornerRadius="2" Margin="8,12,0,12"
                                    Background="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                    Opacity="{Binding RankOpacity}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,10,0"
                                        VerticalAlignment="Center">
                                <Border x:Name="MultiBadge" CornerRadius="5" BorderThickness="1" Padding="5,1"
                                        Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.75" Visibility="Collapsed"
                                        BorderBrush="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}">
                                    <TextBlock Text="多行" FontSize="10" />
                                </Border>
                                <TextBlock Text="{Binding Preview}" FontSize="13.5" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" FontSize="11.5" Opacity="0.62"
                                       VerticalAlignment="Center" Margin="8,0,14,0" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMultiLine}" Value="True">
                                <Setter TargetName="MultiBadge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空状态 -->
            <StackPanel x:Name="EmptyState" Grid.Row="1" Margin="22,10,22,24" Visibility="Collapsed">
                <TextBlock Text="还没有可粘贴的内容" Style="{StaticResource RowLabel}" />
                <TextBlock Text="先复制一段文字，再按一次粘贴键就会出现在这里。" Style="{StaticResource RowHint}"
                           Margin="0,5,0,0" />
            </StackPanel>

            <!-- 快捷键提示 -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource OutlineVariantBrush}"
                    Padding="18,9,18,10">
                <StackPanel x:Name="HintBar" Orientation="Horizontal" />
            </Border>
        </Grid>
    </Border>
</Window>