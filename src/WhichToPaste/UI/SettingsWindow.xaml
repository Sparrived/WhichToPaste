<Window x:Class="WhichToPaste.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhichToPaste 设置" Width="580" SizeToContent="Height" MaxHeight="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Border Margin="16" CornerRadius="20" BorderThickness="1"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource OutlineVariantBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.24" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Grid Grid.Row="0" Margin="22,18,14,6" Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarDrag">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="AppMark" Width="30" Height="30" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WhichToPaste" Style="{StaticResource DialogTitle}" />
                        <TextBlock Text="复制即记录，粘贴前挑一条" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="OnCloseClicked" ToolTip="关闭（程序继续在托盘运行）" />
            </Grid>

            <ScrollViewer x:Name="ContentScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="640"
                          Margin="0,6,0,0">
                <StackPanel Margin="22,4,22,22">

                    <!-- 快捷键 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="快捷键" Style="{StaticResource SectionLabel}" />
                            <TextBlock Style="{StaticResource RowHint}" Margin="0,6,0,14"
                                       Text="选择框弹出后按这些键操作；再按一次「粘贴」键即粘贴当前选中项。点键帽后按新组合即可修改。" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="弹出选择框（粘贴）" Style="{StaticResource RowLabel}"
                                           Margin="0,0,0,8" />
                                <Button Grid.Row="0" Grid.Column="1" x:Name="PasteKeyButton"
                                        Style="{StaticResource KeycapButton}" Margin="0,0,0,8"
                                        Click="OnCapturePasteKey" />

                                <TextBlock Grid.Row="1" Text="上移一项" Style="{StaticResource RowLabel}"
                                           Margin="0,0,0,8" />
                                <Button Grid.Row="1" Grid.Column="1" x:Name="UpKeyButton"
                                        Style="{StaticResource KeycapButton}" Margin="0,0,0,8"
                                        Click="OnCaptureUpKey" />

                                <TextBlock Grid.Row="2" Text="下移一项" Style="{StaticResource RowLabel}"
                                           Margin="0,0,0,8" />
                                <Button Grid.Row="2" Grid.Column="1" x:Name="DownKeyButton"
                                        Style="{StaticResource KeycapButton}" Margin="0,0,0,8"
                                        Click="OnCaptureDownKey" />

                                <TextBlock Grid.Row="3" Text="关闭选择框" Style="{StaticResource RowLabel}"
                                           Margin="0,0,0,8" />
                                <Button Grid.Row="3" Grid.Column="1" x:Name="CancelKeyButton"
                                        Style="{StaticResource KeycapButton}" Margin="0,0,0,8"
                                        Click="OnCaptureCancelKey" />

                                <TextBlock Grid.Row="4" Text="关闭选择框（备用）" Style="{StaticResource RowLabel}" />
                                <Button Grid.Row="4" Grid.Column="1" x:Name="CancelAltKeyButton"
                                        Style="{StaticResource KeycapButton}" Click="OnCaptureCancelAltKey" />
                            </Grid>
                            <Button Content="恢复默认快捷键" Style="{StaticResource TextButton}"
                                    HorizontalAlignment="Left" Margin="-16,12,0,0" Click="OnResetHotkeysClicked" />
                        </StackPanel>
                    </Border>

                    <!-- 触发方式 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="触发方式" Style="{StaticResource SectionLabel}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="在输入框上右键直接弹出选择框" Style="{StaticResource RowLabel}" />
                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,4,0,0"
                                               Text="关闭后右键仍是系统菜单，只保留 Ctrl+V 触发。" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" x:Name="RightClickSwitch"
                                              Style="{StaticResource MaterialSwitch}" VerticalAlignment="Center"
                                              Click="OnRightClickToggled" />
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="暂停监听" Style="{StaticResource RowLabel}" />
                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,4,0,0"
                                               Text="暂停后不再记录复制，粘贴恢复系统默认行为。" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" x:Name="PauseSwitch"
                                              Style="{StaticResource MaterialSwitch}" VerticalAlignment="Center"
                                              Click="OnPauseToggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 历史 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="历史" Style="{StaticResource SectionLabel}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="保留条数" Style="{StaticResource RowLabel}" />
                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,4,0,0"
                                               Text="1 - 200 条，超出后自动丢弃最旧的记录，图片一并从本机数据目录清理。" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="LimitBox" Style="{StaticResource OutlinedTextBox}" Width="70"
                                             TextAlignment="Center" MaxLength="3" TextChanged="OnLimitChanged" />
                                    <TextBlock Text="条" Style="{StaticResource RowLabel}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="清空历史" Style="{StaticResource TextButton}"
                                        Margin="-16,0,0,0" Click="OnClearHistoryClicked" />
                                <TextBlock x:Name="HistorySummary" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 常规 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="常规" Style="{StaticResource SectionLabel}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="开机自启动" Style="{StaticResource RowLabel}" />
                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,4,0,0"
                                               Text="写入当前用户的启动项，不需要管理员权限。" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" x:Name="AutoStartSwitch"
                                              Style="{StaticResource MaterialSwitch}" VerticalAlignment="Center"
                                              Click="OnAutoStartToggled" />
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="外观" Style="{StaticResource RowLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ToggleButton x:Name="ThemeSystem" Style="{StaticResource SegmentToggle}"
                                                  Content="跟随系统" Margin="0,0,6,0" Click="OnThemeSystemClicked" />
                                    <ToggleButton x:Name="ThemeLight" Style="{StaticResource SegmentToggle}"
                                                  Content="浅色" Margin="0,0,6,0" Click="OnThemeLightClicked" />
                                    <ToggleButton x:Name="ThemeDark" Style="{StaticResource SegmentToggle}"
                                                  Content="深色" Click="OnThemeDarkClicked" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="退出 WhichToPaste" Style="{StaticResource DangerTextButton}"
                                Click="OnQuitClicked" />
                    </StackPanel>

                    <TextBlock x:Name="FooterText" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>